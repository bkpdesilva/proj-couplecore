rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: read/write own doc; any authenticated user can read others (for name lookup)
    // Writing another user's doc is needed when accepting a partner link (both sides updated)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        // Partner link acceptance updates both user docs in a transaction
        request.auth != null
      );
    }

    // Moods: own mood + partner's mood (if linked)
    match /moods/{moodId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == moodId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.partnerUid == moodId
      );
    }

    // Alerts: recipient can read; sender can create; both can update (mark as read)
    match /alerts/{alertId} {
      allow read: if request.auth != null && (
        resource.data.toUid == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      );
      allow create: if request.auth != null &&
        request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.toUid == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      );
    }

    // Link requests: sender can create; both parties can read and update
    match /link_requests/{requestId} {
      allow create: if request.auth != null &&
        request.resource.data.fromUid == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow update: if request.auth != null && (
        resource.data.toUid == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      );
    }

    // Couples: members can read/write their couple doc
    match /couples/{coupleId} {
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.members;
      allow read, update: if request.auth != null &&
        request.auth.uid in resource.data.members;
    }

    // Problem sessions: both partners in the couple can read/write
    match /problem_sessions/{sessionId} {
      allow read, write: if request.auth != null &&
        request.auth.uid in resource.data.partnerUids;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.partnerUids;

      // Messages subcollection: same access as parent session
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
      }
    }
  }
}
