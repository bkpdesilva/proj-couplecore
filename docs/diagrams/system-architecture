        SOLVE["Solve-extract fn<br>planned server-side"]
        TITLE["Auto-title fn<br>planned server-side"]
        ESCALATE["Emergency escalation<br>planned"]
        SCHED["Scheduled jobs / unlink cleanup<br>planned"]
  end
 subgraph EXTERNAL["External providers - via Functions only"]
        LLM["LLM API - Gemini"]
